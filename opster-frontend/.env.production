# 生产环境配置
# 部署时修改为你的后端服务器地址
# 示例1：前后端在同一个域名下，使用相对路径
VITE_API_BASE_URL=/api

# WebSocket 服务地址 (生产环境)
# 示例1：前后端同域名
VITE_WS_BASE_URL=ws://172.16.113.220:8080
# 示例2：使用 WSS (HTTPS 环境)
#VITE_WS_BASE_URL=wss://your-domain.com

# 示例2：后端在独立服务器/端口
#VITE_API_BASE_URL=http://172.16.113.220:8089/api
#VITE_WS_BASE_URL=ws://172.16.113.220:8089

# 示例3：使用 Nginx 反向代理
#VITE_API_BASE_URL=/api
#VITE_WS_BASE_URL=ws://your-domain.com
